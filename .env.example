# Copiar a .env y completar. El .env no se versiona.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=school-guardian;User Id={user};Password={password};TrustServerCertificate=True;Pooling=True;Min Pool Size=2;Max Pool Size=40;Connection Timeout=15;ConnectRetryCount=1;ConnectRetryInterval=10;MultipleActiveResultSets=False

# gRPC endpoint for ms-fleet (bus assignment lookups)
Fleet__GrpcAddress=http://ms-fleet:5001
Fleet__ApiKey=changeme

# Validacion de buses: ms-fleet sigue exponiendo REST.
Fleet__BaseUrl={fleet-base-url}

# Auth: identity arrives via the gateway X-User-* headers (no JWT secret needed).

# HTTP/1.1 para Kong (controladores REST).
ASPNETCORE_Kestrel__Endpoints__Http__Url=http://0.0.0.0:8080
ASPNETCORE_Kestrel__Endpoints__Http__Protocols=Http1

# h2c (HTTP/2 sin TLS), exclusivo para el gRPC interno entre servicios.
ASPNETCORE_Kestrel__Endpoints__Grpc__Url=http://0.0.0.0:5001
ASPNETCORE_Kestrel__Endpoints__Grpc__Protocols=Http2
